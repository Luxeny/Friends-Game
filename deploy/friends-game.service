[Unit]
Description=Friends Game (Next.js + Socket.io)
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/var/www/friends-game
Environment=NODE_ENV=production
Environment=PORT=8080
Environment=HOSTNAME=127.0.0.1
EnvironmentFile=/var/www/friends-game/.env
ExecStart=/usr/bin/node /var/www/friends-game/server/preload.cjs
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
