# Порт сервера (Next.js + WebSocket)
PORT=3000

# --- AI (рекомендуется Groq — бесплатно и быстро) ---
# Регистрация: https://console.groq.com

GROQ_API_KEY=gsk_...

# Модель для вопросов и реплик Neko-01 (Qwen3 — лучше русский; Llama 70B — запасной вариант)
GROQ_CHAT_MODEL=qwen/qwen3-32b

# Быстрая модель-судья для сравнения ответов (YES/NO)
GROQ_JUDGE_MODEL=llama-3.1-8b-instant

# Альтернативы, если Qwen недоступен:
# GROQ_CHAT_MODEL=llama-3.3-70b-versatile
# GROQ_CHAT_MODEL=llama-3.1-8b-instant

# --- OpenAI (платно, если Groq не подходит) ---
# OPENAI_API_KEY=sk-...
# OPENAI_CHAT_MODEL=gpt-4o-mini

# --- Ollama локально (embeddings, если свой сервер) ---
# OLLAMA_URL=http://localhost:11434

# Порог схожести для fallback без LLM (0.0–1.0)
ANSWER_SIMILARITY_THRESHOLD=0.72
